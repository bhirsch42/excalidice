{
  "manifest_version": 3,
  "name": "Excalidice",
  "version": "0.1.3",
  "description": "3D dice for Excalidraw, with exploding dice. Everyone in a live collaboration sees the same rolls.",
  "homepage_url": "https://github.com/bhirsch42/excalidice",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://excalidraw.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://excalidraw.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
